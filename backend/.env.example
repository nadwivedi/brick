# Copy to .env and fill in real values. Never commit .env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bricksoft
# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d
NODE_ENV=development
# Frontend address(es) allowed to call this API, comma separated. On deployment, set your live site, e.g. https://www.example.com
FRONTEND_URL=http://localhost:5173
# Address of the Brick Manager app, opened by "Open app" in the admin panel (default https://app.brickmanager.in)
# APP_URL=http://localhost:5175
# Deploy button in the admin panel: the pm2 name of this backend (default bricksoft), repo folder and branch
# DEPLOY_PM2_NAME=bricksoft
# DEPLOY_REPO_DIR=/var/www/bricksoft
# DEPLOY_BRANCH=main
