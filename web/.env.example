# Copy to .env. Only VITE_-prefixed variables reach the browser, so never put secrets here.
# Address of the Brick Manager app (frontend/), opened by the Login and Register buttons
VITE_APP_URL=https://app.brickmanager.in
# For local development: VITE_APP_URL=http://localhost:5175

# Public contact details shown on the homepage. Leave blank to show placeholders.
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_ADDRESS=
# WhatsApp number with country code, digits only, e.g. 919876543210
VITE_WHATSAPP_NUMBER=
# Public website address, e.g. https://www.example.com. Used for canonical links on product pages.
VITE_SITE_URL=
